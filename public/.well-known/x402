      "networks": [
        "base-sepolia",
        "solana"
      ],
      "asset": "USDC",
      "accepts": [
        {
          "scheme": "exact",
          "network": "base-sepolia",
          "asset": "USDC",
          "assetAddress": "0x036CbD53842c5426634e7929541eC2318f3dCF7e",
          "payTo": "0x40252CFDF8B20Ed757D61ff157719F33Ec332402",
          "facilitator": "https://x402.org/facilitator",
          "maxAmountRequired": "1000"
        },
        {
          "scheme": "exact",
          "network": "solana",
          "asset": "USDC",
          "assetAddress": "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v",
          "payTo": "WwwuGbqHrwF5RG89KhUbmRWEvjnRH9k5kVM5p7T3WwW",
          "facilitator": "https://facilitator.payai.network",
          "maxAmountRequired": "1000"
        }
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "pool": {
            "type": "object",
            "properties": {
              "poolId": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              },
              "merchant": {
                "type": "string"
              },
              "totalUsd": {
                "type": "number"
              },
              "shareUnitUsd": {
                "type": "number"
              },
              "unitsRequired": {
                "type": "integer"
              },
              "unitsPaid": {
                "type": "integer"
              },
              "status": {
                "type": "string",
                "enum": [
                  "open",
                  "funded",
                  "expired"
                ]
              },
              "expiresAt": {
                "type": "string"
              }
            }
          },
          "joinLinks": {
            "type": "object",
            "properties": {
              "human": {
                "type": "string"
              },
              "agentPay": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "proof": {
                "type": "string"
              }
            }
          }
        }
      }
    },
