          "maxAmountRequired": "10000"
        }
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "receipt": {
            "type": "object",
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "receiptId": {
                    "type": "string"
                  },
                  "poolId": {
                    "type": "string"
                  },
                  "wallet": {
                    "type": "string"
                  },
                  "unitUsd": {
                    "type": "number"
                  },
                  "unitsPaid": {
                    "type": "integer"
                  },
                  "unitsRequired": {
                    "type": "integer"
                  },
                  "remainingUsd": {
                    "type": "number"
                  },
                  "poolStatus": {
                    "type": "string"
                  },
                  "paidAt": {
                    "type": "string"
                  }
                }
              },
              "signature": {
                "type": "string"
              },
              "algorithm": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ]
