{
  "openapi": "3.1.0",
  "info": {
    "title": "x402-group-pay",
    "version": "0.1.0",
    "description": "Split one booking across N wallets — pooled x402 contributions with signed receipts and funded proofs. Paid routes respond 402 with a dual-rail x402 challenge (USDC on Base and USDC on Solana) until an X-PAYMENT header settles on either rail.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "contact": {
      "name": "nirholas",
      "email": "nichxbt@gmail.com",
      "url": "https://github.com/nirholas/x402-group-pay"
    }
  },
  "servers": [
    {
      "url": "http://localhost:4021",
      "description": "local dev"
    },
    {
      "url": "https://your-deployment.example.com",
      "description": "self-hosted"
    }
  ],
  "components": {
    "schemas": {
      "PaymentRequirements": {
        "type": "object",
        "description": "x402 payment requirements returned with HTTP 402. `accepts` always carries BOTH rails — USDC on Base (EVM) and USDC on Solana — at the same price; the client picks one.",
        "properties": {
          "x402Version": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          },
          "accepts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "scheme": {
                  "type": "string"
                },
                "network": {
                  "type": "string"
                },
                "maxAmountRequired": {
                  "type": "string"
                },
                "resource": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "mimeType": {
                  "type": "string"
                },
                "payTo": {
                  "type": "string"
                },
                "maxTimeoutSeconds": {
                  "type": "integer"
                },
                "asset": {
                  "type": "string"
                },
                "extra": {
                  "type": "object",
                  "description": "EVM: EIP-712 domain (name/version). Solana: {name, decimals, feePayer} — feePayer sponsors the SOL network fee so the buyer needs only USDC."
                }
              }
            },
            "description": "One entry per accepted payment rail. Pay whichever matches your wallet."
          }
        },
        "examples": [
          {
            "x402Version": 1,
            "error": "X-PAYMENT header is required",
            "accepts": [
              {
                "scheme": "exact",
                "network": "base-sepolia",
                "maxAmountRequired": "1000",
                "resource": "https://pay.example.com/pools",
                "description": "x402-group-pay: POST /pools",
                "mimeType": "application/json",
                "payTo": "0x40252CFDF8B20Ed757D61ff157719F33Ec332402",
                "maxTimeoutSeconds": 60,
                "asset": "0x036CbD53842c5426634e7929541eC2318f3dCF7e",
                "extra": {
                  "name": "USDC",
                  "version": "2"
                }
              },
              {
                "scheme": "exact",
                "network": "solana",
                "maxAmountRequired": "1000",
                "resource": "https://pay.example.com/pools",
                "description": "x402-group-pay: POST /pools",
                "mimeType": "application/json",
                "payTo": "WwwuGbqHrwF5RG89KhUbmRWEvjnRH9k5kVM5p7T3WwW",
                "maxTimeoutSeconds": 60,
                "asset": "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v",
                "extra": {
                  "name": "USD Coin",
                  "decimals": 6,
                  "feePayer": "2wKupLR9q6wXYppw8Gr2NvWxKBUqm4PPJKkQfoxHDBg4",
                  "amount": "1000"
                }
              }
            ]
          }
        ]
      },
      "SignedArtifact": {
        "type": "object",
        "properties": {
          "payload": {
            "type": "object"
          },
          "signature": {
            "type": "string"
          },
          "algorithm": {
            "type": "string",
            "const": "HMAC-SHA256"
          },
          "canonicalization": {
            "type": "string",
            "const": "sorted-json"
          }
        },
        "required": [
          "payload",
          "signature"
        ]
      },
      "Pool": {
        "type": "object",
        "properties": {
          "poolId": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "merchant": {
            "type": "string"
          },
          "asset": {
            "type": "string"
          },
          "network": {
            "type": "string",
            "description": "Rails this pool accepts, e.g. \"base-sepolia | solana\"."
          },
          "totalUsd": {
            "type": "number"
          },
          "shareUnitUsd": {
            "type": "number"
          },
          "unitsRequired": {
            "type": "integer"
          },
          "unitsPaid": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "funded",
              "expired"
            ]
          },
          "contributions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Contribution"
            }
          },
          "createdAt": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string"
          },
          "fundedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "railBreakdown": {
            "$ref": "#/components/schemas/RailBreakdown"
          }
        }
      },
      "PaymentReceipt": {
        "type": "object",
        "description": "Settlement receipt, base64-JSON in the X-PAYMENT-RESPONSE header of every paid 200.",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "rail": {
            "type": "string",
            "enum": [
              "evm",
              "solana"
            ]
          },
          "network": {
            "type": "string"
          },
          "transaction": {
            "type": [
              "string",
              "null"
            ]
          },
          "payer": {
            "type": [
              "string",
              "null"
            ]
          },
          "amount": {
            "type": "string"
          },
          "asset": {
            "type": "string",
            "const": "USDC"
          }
        }
      },
      "Contribution": {
        "type": "object",
        "description": "One settled share unit. `rail` records which network funded it — members of one pool may mix rails.",
        "properties": {
          "receiptId": {
            "type": "string"
          },
          "wallet": {
            "type": "string"
          },
          "unitUsd": {
            "type": "number"
          },
          "rail": {
            "type": "string",
            "enum": [
              "evm",
              "solana",
              "unknown"
            ]
          },
          "network": {
            "type": "string"
          },
          "settlementTx": {
            "type": [
              "string",
              "null"
            ]
          },
          "paidAt": {
            "type": "string"
          }
        }
      },
      "RailBreakdown": {
        "type": "object",
        "description": "Units funded per rail.",
        "properties": {
          "evm": {
            "type": "integer"
          },
          "solana": {
            "type": "integer"
          },
          "unknown": {
            "type": "integer"
          }
        }
      }
    },
    "responses": {
      "PaymentRequired": {
        "description": "Payment required (x402)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/PaymentRequirements"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/pools": {
      "post": {
        "summary": "Create a group-payment pool ($0.001)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "purpose",
                  "totalUsd"
                ],
                "properties": {
                  "purpose": {
                    "type": "string"
                  },
                  "merchant": {
                    "type": "string"
                  },
                  "totalUsd": {
                    "type": "number"
                  },
                  "expiresInHours": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pool record + join links",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "pool": {
                      "$ref": "#/components/schemas/Pool"
                    },
                    "joinLinks": {
                      "type": "object",
                      "properties": {
                        "human": {
                          "type": "string"
                        },
                        "agentPay": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string"
                        },
                        "proof": {
                          "type": "string"
                        }
                      }
                    },
                    "note": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "headers": {
              "X-PAYMENT-RESPONSE": {
                "description": "Base64 JSON settlement receipt.",
                "schema": {
                  "$ref": "#/components/schemas/PaymentReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body"
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          },
          "502": {
            "description": "Facilitator unreachable or settlement error — nothing was charged.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-PAYMENT",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Base64-encoded x402 payment payload. Its `network` selects the rail (base-sepolia/base or solana/solana-devnet). Omit it to receive the 402 challenge."
          }
        ]
      }
    },
    "/pools/{id}/pay": {
      "post": {
        "summary": "Contribute one share unit ($0.01) — signed contribution receipt",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-PAYMENT",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Base64-encoded x402 payment payload. Its `network` selects the rail (base-sepolia/base or solana/solana-devnet). Omit it to receive the 402 challenge."
          }
        ],
        "responses": {
          "200": {
            "description": "Signed contribution receipt",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "receipt": {
                      "$ref": "#/components/schemas/SignedArtifact"
                    }
                  }
                }
              }
            },
            "headers": {
              "X-PAYMENT-RESPONSE": {
                "description": "Base64 JSON settlement receipt.",
                "schema": {
                  "$ref": "#/components/schemas/PaymentReceipt"
                }
              }
            }
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          },
          "404": {
            "description": "Pool not found — includes signed refund claim",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "refundClaim": {
                      "$ref": "#/components/schemas/SignedArtifact"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Pool funded or expired — includes signed refund claim",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "refundClaim": {
                      "$ref": "#/components/schemas/SignedArtifact"
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "Facilitator unreachable or settlement error — nothing was charged.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/pools/{id}": {
      "get": {
        "summary": "Pool status (free)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Live pool record",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "pool": {
                      "$ref": "#/components/schemas/Pool"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Pool not found"
          }
        }
      }
    },
    "/pools/{id}/proof": {
      "get": {
        "summary": "Funded proof (free)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pending snapshot, or signed funded proof once complete",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "funded"
                      ]
                    },
                    "proof": {
                      "$ref": "#/components/schemas/SignedArtifact"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Pool not found"
          }
        }
      }
    },
    "/verify": {
      "post": {
        "summary": "Verify any signed artifact issued by this server (free)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "payload",
                  "signature"
                ],
                "properties": {
                  "payload": {
                    "type": "object"
                  },
                  "signature": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "valid": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Health check (free)",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/.well-known/x402": {
      "get": {
        "summary": "x402 discovery manifest (free)",
        "responses": {
          "200": {
            "description": "Manifest JSON"
          }
        }
      }
    }
  }
}
